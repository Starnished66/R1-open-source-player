# Vendored dependencies -- the Makefile clones/downloads all of these fresh
# on first build (see the ifeq($(wildcard ...)) blocks near its top), so
# committing them here would just be an untracked-drift-prone copy of
# someone else's upstream repo.
/lvgl
/dr_libs
/tinyalsa
/faad2
/alac
/mbedtls
/cJSON
/dbus
/opus
/lua
/libexecinfo
/jpeg

# theme2 UI assets. This tree mirrors the device layout: everything tracked
# here is copied to /usr/resource/litegui/theme2/ by scripts/repack_upt.sh,
# so a tracked file is exactly a shipped file.
#
# Stock HiBy graphics are proprietary and never redistributed (see README.md's
# own note). Populate those locally from your own device/firmware dump; the
# blanket exclude below keeps them from being committed by accident.
#
# Everything re-included below is this project's own work, each directory
# carrying its own SOURCES.txt recording the upstream icon set and license
# (Phosphor/Lucide MIT, Montserrat OFL) or confirmed absent from a genuine
# stock dump. Excluding everything first, then re-including specific paths one
# directory level at a time -- git won't apply a file-level negation inside a
# directory that is still itself excluded, so each level needs its own `!`
# before the next.
/assets/theme2/*

# Wholly ours, minus the stock files that happen to share the directory.
!/assets/theme2/power_action/
!/assets/theme2/pull_down/
/assets/theme2/pull_down/bg.png
!/assets/theme2/topbar/
/assets/theme2/topbar/*
!/assets/theme2/topbar/lucide_*.png
!/assets/theme2/topbar/LUCIDE_SOURCES.txt
!/assets/theme2/topbar/SOURCES.txt
!/assets/theme2/topbar/aac.png
!/assets/theme2/topbar/sbc.png
!/assets/theme2/topbar/ldac.png
!/assets/theme2/topbar/aptx.png
!/assets/theme2/topbar/aptx_hd.png
!/assets/theme2/topbar/uat.png
!/assets/theme2/boot_animation/
/assets/theme2/boot_animation/*
!/assets/theme2/boot_animation/en/
/assets/theme2/boot_animation/en/*
!/assets/theme2/boot_animation/en/0.png
!/assets/theme2/boot_animation/en/0.jpg
!/assets/theme2/boot_animation/en/config.ini
!/assets/theme2/boot_animation/en/push.bat
!/assets/theme2/stream_media/
/assets/theme2/stream_media/*
!/assets/theme2/stream_media/subsonic.png
!/assets/theme2/stream_media/subsonic_s.png
!/assets/theme2/stream_media/download.png
!/assets/theme2/playing_plane/
/assets/theme2/playing_plane/*
!/assets/theme2/playing_plane/airplay_logo_white.png
# Wholly ours (SOURCES.txt / LIST_SOURCES.txt), except the per-tile list
# backgrounds, which nothing renders since the tiles went flat.
!/assets/theme2/wireless/
/assets/theme2/wireless/list_bg_*.png

# Korean.ttf-derived host-simulator font: excluded, unlike the rest of
# assets/fonts/, because this particular file's own embedded metadata
# doesn't state a license (see assets/fonts/NOTICE.md). Populate locally
# from your own device dump (/usr/resource/fonts/Korean.ttf, subsetted to
# U+1100-11FF,U+3130-318F,U+AC00-D7A3) if you want Korean text to render in
# `make host`'s simulator -- on target this is a non-issue, the real device
# build reads Korean.ttf directly from the stock firmware at runtime.
/assets/fonts/korean.ttf

