# Local weekly-release guide and staging/output directories. The repack
# script itself uses a temporary directory, but reproducing the workflow
# locally creates these directories in the repository root.
/WEEKLY_RELEASES.md
/base/
/release/

# Host-only runtime state (target uses /usr/data instead)
/open_hiby_player_settings.txt*
/open_hiby_player_peq.txt*
/open_hiby_player_music.db
/.open_hiby_player/books.list

# Host-only test audio fixtures (generated locally for manual verification,
# not needed to build or run the project)
/music/

# Local Python helper scripts, including files created in any future
# subdirectory. Tracked Python files remain tracked by Git as usual.
*.py
# ...except the compile_commands.json generator the Makefile's own
# `compile_commands.json` target invokes -- this one ships with the repo.
!/generate_compile_commands.py

# Standalone development self-tests are local-only and are not shipped in
# the public source/release tree. Match future files in any directory too.
*selftest*
*self_test*

# *_test.c files (playlist_test.c, charge_limiter_test.c, etc.) are local-
# only from here forward -- explicit request, distinct from the
# *selftest*/*self_test* rule above. Does not retroactively untrack the
# handful already committed (cover_decode_scale_test.c, metadata_artwork_
# test.c, playlist_test.c, screen_builders_test.c, sd_ready_test.c) --
# gitignore never affects files git already tracks; `git rm --cached` them
# too if the intent is to stop tracking those as well.
*_test.c

# Local GUI-refactor extraction workspace
/scratch/

