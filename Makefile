build_target/cjson/%.o: $(CJSON_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CROSS_CC) $(TARGET_CFLAGS) -c $< -o $@

build_target/sqlite3/%.o: $(SQLITE_DIR)/%.c
