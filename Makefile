build_target/alac/%.o: $(ALAC_DIR)/codec/%.c
	@mkdir -p $(dir $@)
	$(CROSS_CC) $(ALAC_CFLAGS) -c $< -o $@

build_target/alac/%.o: $(ALAC_DIR)/codec/%.cpp
	@mkdir -p $(dir $@)
