@@ -253,6 +413,57 @@ static void flush_cb(lv_display_t * disp, const lv_area_t * area, uint8_t * colo
 {
     lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
 
+#if !LV_LINUX_FBDEV_BSD
+    if(dsc->pan_double_buffer) {
+        /* An external caller (the transition compositor) currently owns
+         * page presentation -- see lv_linux_fbdev_begin_external_
+         * composition(). Invalidation is disabled for that whole window so
+         * nothing should ever queue a real LVGL flush during it, but this
+         * is a deliberate defense-in-depth guard rather than an assumption:
+         * panning independently here, on top of whatever the external
+         * caller is doing, would be an immediate tear/corruption risk. Just
+         * drop the flush -- there is nothing safe to do with it. */
+        if(dsc->external_composition_active) {
+            lv_display_flush_ready(disp);
+            return;
+        }
+        /* Nothing to copy -- LVGL already rendered straight into whichever
+         * physical half (page0/page1) it picked for this frame. Once that
+         * frame is fully drawn (all its dirty areas flushed), pan to that
+         * half so it becomes the one actually being scanned out. The half
+         * NOT being displayed is always safe to render into regardless of
+         * scanout timing, which is what actually kills the tearing -- the
+         * pan itself only needs to line up with vblank, which fbdev drivers
+         * are expected to handle internally for FBIOPAN_DISPLAY. An earlier
+         * version of this also called FBIO_WAITFORVSYNC before panning as
+         * an extra safety net, but on real hardware that added a
+         * noticeable, consistent bump to touch-to-screen latency on EVERY
+         * redraw (not just transitions) -- likely double-waiting for a
+         * vblank the pan was already going to wait for on its own. Removed;
+         * if a future panel needs it back, gate it behind a flag rather
+         * than always-on. */
+        if(lv_display_flush_is_last(disp)) {
+            uint32_t target_yoffset = (color_p == dsc->page1) ? dsc->page_yoffset : 0;
+            if(dsc->vinfo.yoffset != target_yoffset) {
+                /* Temporary copy, committed only on success -- see
+                 * lv_linux_fbdev_present_external_page()'s own comment on
+                 * why writing dsc->vinfo.yoffset before confirming the
+                 * ioctl succeeded is a real desync risk, not just tidiness. */
+                struct fb_var_screeninfo tmp = dsc->vinfo;
+                tmp.yoffset = target_yoffset;
+                if(ioctl(dsc->fbfd, FBIOPAN_DISPLAY, &tmp) == -1) {
+                    perror("Error panning display");
+                }
+                else {
+                    dsc->vinfo.yoffset = target_yoffset;
+                }
+            }
+        }
+        lv_display_flush_ready(disp);
+        return;
+    }
+#endif /* !LV_LINUX_FBDEV_BSD */
+
     if(dsc->fbp == NULL ||
        area->x2 < 0 || area->y2 < 0 ||
        area->x1 > (int32_t)dsc->vinfo.xres - 1 || area->y1 > (int32_t)dsc->vinfo.yres - 1) {
diff --git a/src/drivers/display/fb/lv_linux_fbdev.h b/src/drivers/display/fb/lv_linux_fbdev.h
index c14e973..b3e639a 100644
--- a/src/drivers/display/fb/lv_linux_fbdev.h
+++ b/src/drivers/display/fb/lv_linux_fbdev.h
@@ -39,6 +39,77 @@ void lv_linux_fbdev_set_file(lv_display_t * disp, const char * file);
  */
 void lv_linux_fbdev_set_force_refresh(lv_display_t * disp, bool enabled);
 
+/**
+ * When double buffering via panning is active (see lv_linux_fbdev.c's
+ * pan_double_buffer), returns a pointer to whichever physical half is
+ * CURRENTLY being scanned out -- i.e. exactly what's on screen right now,
+ * with no render needed to get it. Const: callers only ever need to COPY
+ * this (e.g. into an owned transition-source buffer), never write into the
+ * page still being displayed. Returns NULL if pan-based double buffering
+ * isn't active for this display.
+ */
+const void * lv_linux_fbdev_get_active_page(lv_display_t * disp);
+
+/**
+ * The physical half NOT currently being scanned out -- i.e. safe to write
+ * into directly regardless of scanout timing, the same guarantee
+ * flush_cb()'s own pan_double_buffer branch relies on. Deliberately
+ * writable (unlike lv_linux_fbdev_get_active_page() above): this is the
+ * one page callers are expected to draw into directly. Returns NULL under
+ * the same conditions lv_linux_fbdev_get_active_page() does.
+ */
+void * lv_linux_fbdev_get_inactive_page(lv_display_t * disp);
+
+/**
+ * Bytes per scanline for the two pan_double_buffer physical pages. Only
+ * meaningful (and only ever non-zero) when pan-based double buffering is
+ * actually active -- lv_linux_fbdev_set_file() itself never enables it
+ * unless the hardware's real line_length exactly matches this same value,
+ * so callers can always treat a non-zero result as "tightly packed,
+ * hor_res * bytes-per-pixel".
+ */
+uint32_t lv_linux_fbdev_get_stride(lv_display_t * disp);
+
+/**
+ * External-composition handoff -- for a caller (the transition compositor)
+ * that wants to write directly into the physical framebuffer pages for a
+ * whole sequence of frames, bypassing LVGL's own render/flush pipeline
+ * entirely. Callers must still separately disable LVGL invalidation for
+ * the duration (lv_display_enable_invalidation()) -- this call only
+ * concerns the fbdev driver's own bookkeeping: it rejects a second, nested
+ * caller, and makes flush_cb() refuse to independently pan while active
+ * (see flush_cb()'s own comment). Returns false (no state changed) if
+ * pan-based double buffering isn't active, or a composition session is
+ * already in progress.
+ */
+bool lv_linux_fbdev_begin_external_composition(lv_display_t * disp);
+
+/**
+ * Pans the display straight to whichever physical half
+ * lv_linux_fbdev_get_inactive_page() currently returns, and updates this
+ * driver's own bookkeeping (vinfo.yoffset) to match -- only after
+ * confirming the underlying FBIOPAN_DISPLAY ioctl actually succeeded (a
+ * failed pan leaves this driver's bookkeeping exactly as it was, so
+ * get_active_page()/get_inactive_page() keep describing the real, still-
+ * physically-current page rather than one that was never actually panned
+ * to). Must be called between a successful lv_linux_fbdev_begin_external_
+ * composition() and its matching end call. Returns false (no-op) if that
+ * precondition isn't met or the underlying pan ioctl itself fails.
+ */
+bool lv_linux_fbdev_present_external_page(lv_display_t * disp);
+
+/**
+ * Ends an external-composition session started by lv_linux_fbdev_begin_
+ * external_composition() -- also re-synchronizes LVGL's own next render
+ * target (disp->buf_act, internal to LVGL's core and not otherwise exposed
+ * outside this driver) to point at the real, current INACTIVE physical
+ * page, so the very next ordinary LVGL render is guaranteed to draw
+ * somewhere safe rather than into whatever page an external caller just
+ * presented. Callers must still separately re-enable LVGL invalidation
+ * afterward. Returns false (no-op) if no composition session is active.
+ */
+bool lv_linux_fbdev_end_external_composition(lv_display_t * disp);
+
