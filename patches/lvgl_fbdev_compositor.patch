+++ b/src/drivers/display/fb/lv_linux_fbdev.c
@@ -71,6 +71,25 @@ typedef struct {
     bool force_refresh;
     uint8_t * draw_buf_1;
     uint8_t * draw_buf_2;
+
+    /* True when /dev/fb0 is double-buffered via panning (yres_virtual >=
+     * 2*yres) and we've handed LVGL the two real physical halves as its
+     * DIRECT-mode draw buffers directly -- see lv_linux_fbdev_set_file().
+     * When true, flush_cb() skips its usual memcpy (pixels already landed
+     * in the right place) and instead pans to whichever half was just
+     * rendered once the frame is complete, tear-free. */
+    bool pan_double_buffer;
+    uint8_t * page0;
+    uint8_t * page1;
+    uint32_t page_yoffset; /* vinfo.yoffset value that selects page1 */
+
+    /* True between a successful lv_linux_fbdev_begin_external_composition()
+     * and its matching lv_linux_fbdev_end_external_composition() -- rejects
+     * a second, nested caller, and lets flush_cb() refuse to independently
+     * pan while some other caller (the transition compositor) owns page
+     * presentation, in case anything ever queues a real LVGL flush during
+     * that window despite invalidation being disabled. */
+    bool external_composition_active;
 } lv_linux_fb_t;
 
 /**********************
@@ -234,14 +253,45 @@ lv_result_t lv_linux_fbdev_set_file(lv_display_t * disp, const char * file)
 
     uint8_t * draw_buf = NULL;
     uint8_t * draw_buf_2 = NULL;
-    draw_buf = lv_malloc(draw_buf_size);
 
-    if(LV_LINUX_FBDEV_BUFFER_COUNT == 2) {
-        draw_buf_2 = lv_malloc(draw_buf_size);
+#if LV_LINUX_FBDEV_MMAP && !LV_LINUX_FBDEV_BSD
+    /* If this display is double-buffered via panning (virtual height is at
+     * least twice the visible height) and we've been asked for DIRECT mode
+     * with 2 buffers, skip malloc entirely and hand LVGL the two physical
+     * halves of the real framebuffer as its draw buffers -- LVGL then
+     * renders straight into whichever half isn't currently on screen, and
+     * flush_cb() below just pans to it once the frame's done. This is what
+     * actually eliminates tearing; DIRECT mode with malloc'd buffers alone
+     * does not (see flush_cb). */
+    long int page_bytes = (long int) dsc->finfo.line_length * dsc->vinfo.yres;
+    if(LV_LINUX_FBDEV_RENDER_MODE == LV_DISPLAY_RENDER_MODE_DIRECT && LV_LINUX_FBDEV_BUFFER_COUNT == 2 &&
+       dsc->vinfo.yres_virtual >= dsc->vinfo.yres * 2 && dsc->finfo.smem_len >= page_bytes * 2 &&
+       /* LVGL assumes tightly-packed rows (stride derived purely from
+        * resolution/color format); if the hardware pads each scanline
+        * beyond that, aliasing its real memory directly would skew the
+        * image, so only do this when there's no such padding. */
+       dsc->finfo.line_length == lv_draw_buf_width_to_stride((uint32_t) hor_res, lv_display_get_color_format(disp))) {
+        dsc->pan_double_buffer = true;
+        dsc->page0 = (uint8_t *)dsc->fbp;
+        dsc->page1 = (uint8_t *)dsc->fbp + page_bytes;
+        dsc->page_yoffset = dsc->vinfo.yres;
+        draw_buf = dsc->page0;
+        draw_buf_2 = dsc->page1;
+        /* Do not store these in draw_buf_1/draw_buf_2 -- del_event_cb()
+         * lv_free()s those, and these are mmap'd framebuffer pages. */
     }
+#endif /* LV_LINUX_FBDEV_MMAP && !LV_LINUX_FBDEV_BSD */
+
+    if(!dsc->pan_double_buffer) {
+        draw_buf = lv_malloc(draw_buf_size);
+
+        if(LV_LINUX_FBDEV_BUFFER_COUNT == 2) {
+            draw_buf_2 = lv_malloc(draw_buf_size);
+        }
 
-    dsc->draw_buf_1 = draw_buf;
-    dsc->draw_buf_2 = draw_buf_2;
+        dsc->draw_buf_1 = draw_buf;
+        dsc->draw_buf_2 = draw_buf_2;
+    }
 
     lv_display_set_resolution(disp, hor_res, ver_res);
     lv_display_set_buffers(disp, draw_buf, draw_buf_2, draw_buf_size, LV_LINUX_FBDEV_RENDER_MODE);
@@ -262,6 +312,98 @@ void lv_linux_fbdev_set_force_refresh(lv_display_t * disp, bool enabled)
     dsc->force_refresh = enabled;
 }
 
+const void * lv_linux_fbdev_get_active_page(lv_display_t * disp)
+{
+    if(!disp) return NULL;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->pan_double_buffer) return NULL;
+    return (dsc->vinfo.yoffset == dsc->page_yoffset) ? dsc->page1 : dsc->page0;
+}
+
+void * lv_linux_fbdev_get_inactive_page(lv_display_t * disp)
+{
+    if(!disp) return NULL;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->pan_double_buffer) return NULL;
+    /* Writable (unlike get_active_page() above) -- callers write into this
+     * one directly, which is exactly what makes it safe to write into: it's
+     * never the page currently being scanned out. */
+    return (dsc->vinfo.yoffset == dsc->page_yoffset) ? dsc->page0 : dsc->page1;
+}
+
+uint32_t lv_linux_fbdev_get_stride(lv_display_t * disp)
+{
+    if(!disp) return 0;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->pan_double_buffer) return 0;
+    return (uint32_t) dsc->finfo.line_length;
+}
+
+bool lv_linux_fbdev_begin_external_composition(lv_display_t * disp)
+{
+    if(!disp) return false;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->pan_double_buffer) return false;
+    if(dsc->external_composition_active) return false; /* reject nested ownership */
+    dsc->external_composition_active = true;
+    return true;
+}
+
+bool lv_linux_fbdev_present_external_page(lv_display_t * disp)
+{
+    if(!disp) return false;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->pan_double_buffer || !dsc->external_composition_active) return false;
+#if LV_LINUX_FBDEV_BSD
+    return false; /* pan_double_buffer is never true on a BSD build (see lv_linux_fbdev_set_file()), so this is unreachable in practice -- kept explicit rather than falling through to code that assumes the Linux fb_var_screeninfo shape */
+#else
+    /* Same target-half computation flush_cb()'s own pan branch uses, just
+     * driven by our own bookkeeping instead of a just-flushed color_p
+     * pointer -- whichever half is currently INACTIVE (about to become
+     * active) is exactly the one the caller just finished writing into. */
+    uint32_t target_yoffset = (dsc->vinfo.yoffset == dsc->page_yoffset) ? 0 : dsc->page_yoffset;
+    if(dsc->vinfo.yoffset == target_yoffset) return true; /* already showing the right page -- nothing to do */
+
+    /* Pan using a TEMPORARY copy, only committing dsc->vinfo.yoffset after
+     * FBIOPAN_DISPLAY actually succeeds -- writing dsc->vinfo.yoffset
+     * before the ioctl would leave this driver's own bookkeeping claiming
+     * a page change that never physically happened, silently desyncing
+     * every later get_active_page()/get_inactive_page() call from the
+     * real hardware state. */
+    struct fb_var_screeninfo tmp = dsc->vinfo;
+    tmp.yoffset = target_yoffset;
+    if(ioctl(dsc->fbfd, FBIOPAN_DISPLAY, &tmp) == -1) {
+        perror("Error panning display");
+        return false;
+    }
+    dsc->vinfo.yoffset = target_yoffset;
+    return true;
+#endif /* LV_LINUX_FBDEV_BSD */
+}
+
+bool lv_linux_fbdev_end_external_composition(lv_display_t * disp)
+{
+    if(!disp) return false;
+    lv_linux_fb_t * dsc = lv_display_get_driver_data(disp);
+    if(!dsc || !dsc->external_composition_active) return false;
+    dsc->external_composition_active = false;
+
+    /* LVGL's own DIRECT-mode buffer alternation (disp->buf_act, toggled only
+     * by lv_refr.c's own flush bookkeeping) has no idea this driver just
+     * panned the physical display independently of any real LVGL render --
+     * left alone, its next render could target buf_act pointing at the
+     * page CURRENTLY being scanned out (whichever one an external caller
+     * just presented), corrupting the live screen mid-redraw instead of
+     * the inactive one. Point buf_act at the real, current INACTIVE
+     * physical page directly so the very next lv_refr_now() is guaranteed
+     * to render somewhere safe to write. */
+    if(dsc->pan_double_buffer) {
+        bool page1_active = (dsc->vinfo.yoffset == dsc->page_yoffset);
+        disp->buf_act = page1_active ? disp->buf_1 : disp->buf_2;
+    }
+    return true;
+}
+
