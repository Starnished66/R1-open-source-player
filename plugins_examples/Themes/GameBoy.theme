# Reference .theme file for plugins_examples/Themes.lua -- see White.theme's
# own header comment for the file format.
#
# Navy pixel boot-menu: square, full-size rows with no chevron/icon, mono
# font, flush left -- retains the Game Boy character without sacrificing
# touch-target size or leaving most of Home empty.
name=Game Boy
screen=0x0A0E17
card=0x11172A
list_row=0x151B30
text_primary=0xEAEAEA
text_muted=0x8A93AD
icon_root=theme2

home_mode=list
home_row_gap=8
home_order=music,stream_media,subsonic,wireless,books,settings,dac

tile.music.bg_color=0x0F1420
tile.music.text_color=0xF4D35E
tile.music.radius=0
tile.music.height=108
tile.music.align=left
tile.music.accessory=false
tile.music.text_size=mono
tile.music.icon=false

