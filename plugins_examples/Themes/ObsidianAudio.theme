# Modern audiophile theme for HiBy R1
#
# Obsidian Audio: compact, modern, high-contrast dark UI designed around
# the R1's small screen and touch-first form factor.
#
# Design goals:
# - Near-black OLED-style background to keep the UI calm and reduce clutter.
# - Cool graphite cards with a restrained cyan accent for audio/network items.
# - Compact rounded list rows so more controls fit on the small display.
# - Stock icons retained for maximum compatibility.
# - Music/DAC are visually emphasized without making every item brightly colored.
#
name=Obsidian Audio
screen=0x080B10
card=0x111722
list_row=0x151D2A
text_primary=0xE8F0F7
text_muted=0x8291A3
icon_root=theme2
drawer_root=theme2

home_mode=list
home_row_gap=7
home_order=music,stream_media,wireless,books,dac,settings
submenu_mode=list

tile.music.bg_color=0x142631
tile.music.text_color=0x73E0E8
tile.music.radius=18
tile.music.height=86
tile.music.width=448
tile.music.align=left
tile.music.accessory=true
tile.music.text_size=medium
tile.music.icon=true

