# Reference .theme file for plugins_examples/Themes.lua -- see White.theme's
# own header comment for the file format.
#
# Green-on-black CRT, but roomier than Game Boy and with its icon + chevron
# kept -- a "real app that happens to use a mono font" feel rather than a
# boot menu.
name=Terminal
screen=0x000000
card=0x0A0A0A
list_row=0x0D140D
text_primary=0xE6FFE6
text_muted=0x2E7D2E
icon_root=theme2

home_mode=list
home_row_gap=10

tile.music.bg_color=0x000000
tile.music.text_color=0x33FF33
tile.music.radius=6
tile.music.height=68
tile.music.width=440
tile.music.align=left
tile.music.accessory=true
tile.music.text_size=mono
tile.music.icon=true

