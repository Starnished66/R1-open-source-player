# R1 station-mode build. Preserve nl80211 + WEXT and the Unix CLI interface.
# Do not inherit upstream defconfig's AP/P2P/MACsec/D-Bus defaults: the player
# uses none of those, and the stock binary has no corresponding dependencies
# or AP/P2P event strings. Keep enterprise EAP, WPS, HS20 and interworking.
CONFIG_DRIVER_WEXT=y
CONFIG_DRIVER_NL80211=y
CONFIG_DRIVER_WIRED=y
CONFIG_DRIVER_NONE=y
CONFIG_LIBNL32=y
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_MD5=y
CONFIG_EAP_TLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_GTC=y
CONFIG_EAP_OTP=y
CONFIG_EAP_SIM=y
CONFIG_EAP_AKA=y
CONFIG_EAP_PSK=y
CONFIG_EAP_PAX=y
CONFIG_EAP_SAKE=y
CONFIG_EAP_GPSK=y
CONFIG_EAP_GPSK_SHA256=y
CONFIG_EAP_PWD=y
CONFIG_EAP_FAST=y
CONFIG_EAP_LEAP=y
CONFIG_EAP_IKEV2=y
CONFIG_EAP_TNC=y
CONFIG_EAP_EKE=y
CONFIG_EAP_TEAP=y
CONFIG_TLS=openssl
CONFIG_PKCS12=y
CONFIG_CTRL_IFACE=y
CONFIG_READLINE=y
CONFIG_WPS=y
CONFIG_SAE=y
CONFIG_IEEE80211W=y
CONFIG_INTERWORKING=y
CONFIG_HS20=y
CONFIG_FILS=y
CONFIG_IEEE80211R=y
CONFIG_IPV6=y
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_FILE=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_BUILD_WPA_CLIENT_SO=y
